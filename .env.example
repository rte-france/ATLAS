# Atlas environment variables — copy to .env and adjust as needed.
# All values shown are the defaults; uncomment to override.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Loguru format string for the stdout sink.
# The run_id and step path are injected automatically as a pipe-separated prefix
# before {message}.
LOG_FORMAT=<green>{time:HH:mm:ss}</green> | <level>{level}</level> | <level>{message}</level>


# ----------------------------------------------s-----------------------------
# Per-run persistence
# ---------------------------------------------------------------------------

# Enable/disable writing record.json + run.log per @step root call.
RUN_RECORD_ENABLED=false

# Directory where each run is persisted (one subfolder per run).
RUN_RECORD_DIR=runs

# Also write a run.log file alongside record.json (per root step).
RUN_RECORD_LOG=true

# Level for the per-run log file (independent of LOG_LEVEL).
RUN_RECORD_LOG_LEVEL=DEBUG
